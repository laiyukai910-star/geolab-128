{
  "name": "geolab-128-local",
  "version": "0.4.0",
  "private": true,
  "description": "Interactive 3D geographic systems laboratory with shared native and WebAssembly Rust verification",
  "main": "main.cjs",
  "scripts": {
    "vendor": "node build-local.mjs --vendor-only",
    "browser:build": "node build-local.mjs --browser-only",
    "wasm:build": "node build-local.mjs --wasm-only",
    "backend:build": "node build-local.mjs --backend-only",
    "typecheck": "tsc --noEmit -p ../geo-sim/tsconfig.json",
    "runtime:build": "node build-local.mjs --prepare-runtime",
    "start": "npm run runtime:build && electron .",
    "package:win": "node build-local.mjs",
    "package:portable": "node build-local.mjs --prepare-runtime && electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/packager": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "esbuild": "latest",
    "geotiff": "2.1.3",
    "three": "0.164.1",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "cn.geolab128.local",
    "productName": "GeoLab 128",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "../GeoLab-128-Portable"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../geo-sim",
        "to": "geo-sim",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GeoLab-128-Local-${version}.${ext}",
      "signAndEditExecutable": false
    }
  }
}
